{
  "name": "orquestivo",
  "displayName": "Orquestivo",
  "description": "Design, inspect, and verify CI/CD workflows with evidence-backed diagnostics.",
  "version": "0.1.0",
  "publisher": "armotusitio",
  "author": {
    "name": "Alejandro Daniel Di Stefano",
    "url": "https://armotusitio.com.ar"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drako01/orquestivo.git"
  },
  "bugs": {
    "url": "https://armotusitio.com.ar/soporte/"
  },
  "homepage": "https://armotusitio.com.ar",
  "private": true,
  "preview": true,
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Other"
  ],
  "keywords": [
    "github actions",
    "ci/cd",
    "workflow",
    "pipeline",
    "yaml",
    "devops",
    "validation",
    "orchestration"
  ],
  "icon": "media/icon-128.png",
  "galleryBanner": {
    "color": "#14181D",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:orquestivo.overview"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workflow analysis requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": true,
      "description": "Static workflow analysis works in virtual workspaces."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "orquestivo.openHome",
        "title": "%command.home%",
        "category": "Orquestivo"
      },
      {
        "command": "orquestivo.analyze",
        "title": "%command.analyze%",
        "category": "Orquestivo",
        "icon": "$(beaker)"
      },
      {
        "command": "orquestivo.openFinding",
        "title": "%command.openFinding%",
        "category": "Orquestivo"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "orquestivo",
          "title": "Orquestivo",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "orquestivo": [
        {
          "id": "orquestivo.overview",
          "name": "%view.overview%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "orquestivo.analyze",
          "when": "view == orquestivo.overview && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "orquestivo.openHome",
          "when": "view == orquestivo.overview",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Orquestivo",
      "properties": {
        "orquestivo.analysis.maxFiles": {
          "type": "integer",
          "default": 150,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum number of workflow files per scan."
        },
        "orquestivo.analysis.maxFileBytes": {
          "type": "integer",
          "default": 1048576,
          "minimum": 1024,
          "maximum": 10485760,
          "description": "Maximum size of one YAML workflow file."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "analyze",
            "title": "%walkthrough.analyze.title%",
            "description": "%walkthrough.analyze.description%",
            "media": {
              "markdown": "docs/WALKTHROUGH.md"
            },
            "completionEvents": [
              "onCommand:orquestivo.analyze"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --outfile=dist/extension.js",
    "build:prod": "npm run build -- --minify",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:analyzer && node --test test/*.test.cjs",
    "verify": "npm run typecheck && npm run test && npm run build:prod",
    "package": "npm run verify && vsce package --no-dependencies --out orquestivo.vsix",
    "vscode:prepublish": "npm run build:prod",
    "build:analyzer": "esbuild src/core/analyzer.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/analyzer.cjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/vscode": "1.99.1",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "5.8.3",
    "ovsx": "1.3.0"
  }
}
