{
  "comment": "Content policy for the packaged VSIX. Paths are relative to the VSIX root (extension/...). Regexes are case-insensitive.",
  "required": [
    "extension/package.json",
    "extension/package.nls.json",
    "extension/package.nls.es.json",
    "extension/dist/extension.js",
    "extension/media/icon-128.png",
    "extension/media/activity.svg",
    "extension/media/brand-approved-full.webp",
    "extension/docs/WALKTHROUGH.md",
    "extension/LICENSE.txt|extension/LICENSE",
    "extension/readme.md|extension/README.md"
  ],
  "forbidden": [
    "^extension/(src|test|dist-test|reports|scripts|node_modules|\\.git|\\.github|\\.vscode)/",
    "^extension/(todo|logs\\.log|test_script\\.ps1|orquestivo\\.vsix|tsconfig\\.json|eslint\\.config\\.mjs|package-lock\\.json)$",
    "^extension/docs/(?!WALKTHROUGH\\.md$)",
    "^extension/media/(brand-approved-full\\.png|readme-logo\\.webp|0[0-9]\\.png)$",
    "(^|/)\\.env",
    "\\.(vsix|log|map|ts|tsx|pem|key|p12|pfx)$",
    "\\.sha256$"
  ],
  "maxVsixBytes": 3145728,
  "maxFileBytes": 1048576,
  "secretPatterns": [
    "-----BEGIN [A-Z ]*PRIVATE KEY-----",
    "ghp_[A-Za-z0-9]{36}",
    "github_pat_[A-Za-z0-9_]{50,}",
    "AKIA[0-9A-Z]{16}",
    "npm_[A-Za-z0-9]{36}",
    "xox[baprs]-[A-Za-z0-9-]{10,}"
  ]
}
